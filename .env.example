# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (MySQL) ---
ROOT_PASSWORD=change-me-root-password
DB_SCHEMA=tailsafe
DB_USER=tailsafe
DB_PASSWORD=change-me-db-password

# --- AI service (Google Gemini) ---
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Shared secret between backend and AI service (any long random string)
AI_API_KEY=change-me-internal-api-key
AI_SERVICE_URL=http://ai:8001
AI_MODEL_NAME=gemini-2.0-flash

# --- Security ---
# At least 32 characters (256-bit) for HMAC-SHA signing
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# --- App ---
# Public URL of the frontend (used for CORS and SSR allowed hosts)
APP_FRONTEND_URL=http://localhost

# --- Deployment ---
# Lowercase GitHub username/org that owns the GHCR images
GHCR_OWNER=your-github-username
